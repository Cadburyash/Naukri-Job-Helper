{
  "manifest_version": 3,
  "name": "Naukri Job Helper",
  "version": "1.3.0",
  "description": "Find Naukri job cards with overlap-based experience filters and assist with sequential applications.",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.naukri.com/*",
    "https://*.naukri.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Naukri Job Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*",
        "https://*.naukri.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
